/**
 * Extraction des épisodes d'un anime
 * @param {string} url - L'URL / href de l'anime
 * @returns {string} JSON stringifié [{href: string, number: number}]
 */
async function extractEpisodes(url) {
    try {
        // {{EPISODES_LOGIC}}
        const response = await fetch(url);
        // Traitement (JSON ou scraping HTML regex)...
        
        const episodes = [
            {
                href: url + '/episode-1',
                // IMPORTANT : number doit impérativement être un entier (int), pas un string
                number: parseInt(1, 10)
            }
        ];
        
        return JSON.stringify(episodes);
    } catch (error) {
        console.log('extractEpisodes error: ' + error);
        return JSON.stringify([]);
    }
}

