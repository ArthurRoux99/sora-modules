/**
 * Recherche de contenu par mot-clé
 * @param {string} keyword - Le terme de recherche
 * @returns {string} JSON stringifié [{title: string, image: string, href: string}]
 */
async function searchResults(keyword) {
    try {
        const encodedKeyword = encodeURIComponent(keyword);
        // {{SEARCH_LOGIC}}
        const response = await fetch(`{{SEARCH_BASE_URL}}${encodedKeyword}`);
        const data = JSON.parse(response);
        
        const results = data.map(item => ({
            title: item.title || item.name || '',
            image: item.image || item.poster || item.thumbnail || '',
            href: item.url || item.href || ''
        }));
        
        return JSON.stringify(results);
    } catch (error) {
        console.log('searchResults error: ' + error);
        return JSON.stringify([{ title: 'Error', image: '', href: '' }]);
    }
}

/**
